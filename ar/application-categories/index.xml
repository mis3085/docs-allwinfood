    &lt;/span&gt;        
    
&lt;/h2&gt;
&lt;div id=&#34;gallery-c4b384c33111cf1ca6499844591fa1fa&#34; class=&#34;gallery&#34;&gt;
  
  
    
    
&lt;figure class=&#34;grid-w50 pb-4 text-center&#34;&gt;&lt;img src=&#34;https://mis3085.github.io/docs-allwinfood/beverage-1_5540647710880344578.jpg&#34; alt=&#34;تشكيلة مسحوق المشروبات&#34; class=&#34;mx-auto max-w-full h-auto&#34;/&gt;&lt;figcaption&gt;تشكيلة مسحوق المشروبات&lt;/figcaption&gt;&lt;/figure&gt;
